# Never commit actual credentials.
# Fresh clone: npm run setup:local generates an isolated local environment.
# Production hosting: DATABASE_URL is your pooled Neon URL; migrations prefer
# DATABASE_URL_UNPOOLED when available. Both are server-only secrets.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
#
# The development DATABASE_URL belongs in .env.development.local — NOT in
# .env.local — so production runs (`next start`) never load it:
#
#   .env.development.local:
#     LOCAL_DATABASE=true
#     DATABASE_URL=postgresql://postgres:local-password@127.0.0.1:55432/postgres?sslmode=disable
#
# scripts/dev.ts serves that dedicated loopback port when LOCAL_DATABASE=true;
# a real local PostgreSQL works too (LOCAL_DATABASE unset, any loopback port).
#
# Production: supply DATABASE_URL through the hosting environment (e.g. Render
# service env vars) or a gitignored .env.production.local — never localhost.
# sslmode=disable is permitted ONLY for loopback development. Remote TLS verifies certificates.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Bootstrap only. Changing these does NOT rotate an existing account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CRON_SECRET=
# Number of trusted append-only reverse proxies between the client and application.
# Verify your actual deployment topology. Production auth/contact fail closed if unset.
TRUSTED_PROXY_HOPS=
NEXT_PUBLIC_SITE_URL=
# Explicit rotation: existing account; optional new address.
# ROTATE_ADMIN_EMAIL=
# ROTATE_ADMIN_PASSWORD=
# ROTATE_ADMIN_NEW_EMAIL=
